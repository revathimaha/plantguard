# Copy to .env and fill in. Only the provider you actually use needs a key.

DATAGEN_PROVIDER=gemini

# Gemini AI Studio -- free tier, get a key at https://aistudio.google.com/apikey
DATAGEN_GEMINI_API_KEY=
DATAGEN_GEMINI_MODEL="gemini-flash-lite-latest"

# OpenRouter -- backup when Gemini rate-limits
DATAGEN_OPENROUTER_API_KEY=
DATAGEN_OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Ollama -- fully local, no key, no rate limit, slower
DATAGEN_OLLAMA_HOST=http://localhost:11434
DATAGEN_OLLAMA_MODEL=llama3.1:8b

# Reproducibility: teams sharing a seed get identical corpora
DATAGEN_SEED=42

# Corpus sizing
DATAGEN_CORPUS_DOCS=50
DATAGEN_INTAKE_RECORDS=200
DATAGEN_EVAL_ITEMS=20

# Corpus text shown to the model when it writes eval cases, in characters,
# shared across all documents. Lower it for a small local model.
# DATAGEN_EVAL_CORPUS_CHARS=160000

DATAGEN_OUTPUT_DIR=./data

# ----------------------------------------------------------------------------
# PlantGuard application runtime (M1-M8). The data toolkit above is separate.
# ----------------------------------------------------------------------------

# LLM for intake parsing and the agent team (LiteLLM provider-prefixed model).
PLANTGUARD_LLM_MODEL="groq/openai/gpt-oss-20b"
PLANTGUARD_LLM_API_KEY=
GROQ_API_KEY=

# Qdrant vector store (M3/M4 retrieval). Required for indexing and search.
QDRANT_URL=
QDRANT_API_KEY=

# Google Generative AI embeddings (M3). Used by langchain-google-genai.
GOOGLE_API_KEY=

# Langfuse tracing (M7). Optional; tracing fails open if unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
